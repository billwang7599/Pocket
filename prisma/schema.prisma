generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "linux-musl", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auth0Id      String?       @unique
  balances     Balance[]
  transactions Transaction[]
}

model Balance {
  id           String        @id @default(cuid())
  amount       Int
  active       Boolean       @default(true)
  userId       String
  currencyId   Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  parentId     String?
  name         String
  currency     Currency      @relation(fields: [currencyId], references: [id])
  parent       Balance?      @relation("BalanceHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Balance[]     @relation("BalanceHierarchy")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  description String
  amount      Int
  userId      String
  balanceId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  type        TransactionType
  date        DateTime
  repeating   Repeating?
  balance     Balance         @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Repeating {
  id            Int         @id @default(autoincrement())
  period        Period
  startDate     DateTime    @db.Date
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Currency {
  id       Int       @id @default(autoincrement())
  code     String    @unique @db.VarChar(3)
  name     String    @unique
  symbol   String    @db.VarChar(5)
  balances Balance[]
}

enum Period {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TransactionType {
  INCOME
  EXPENSE
}
